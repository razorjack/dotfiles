/* Linux/KDE-only (yadm alternate; the ghostty-linux.css symlink exists only on
   Linux): shrink Ghostty's GTK tab bar so it matches the smaller terminal font
   under KDE fractional scaling. There is no per-app scaling on Plasma 6
   Wayland, so this styles the chrome directly. Tune to taste; inspect the live
   GTK node tree with:
     GTK_DEBUG=interactive ghostty  */

/* Colors: stock libadwaita dark grays (~#303030/#404040) glow next to the
   near-black terminal (background = #0c0c0d in linux.conf), so darken the
   whole bar to sit between the two. */

tabbar tabbox {
  min-height: 0;
  margin: 0;
  padding: 0;
  background: #151517;
}

tabbar tabbox tab {
  min-height: 0;
  margin: 0;
  padding: 1px 6px;
  background: transparent;
}

tabbar tabbox tab:hover:not(:selected) {
  background: rgba(255, 255, 255, 0.05);
}

tabbar tabbox tab:selected {
  background: #26262a;
}

tabbar tabbox tab label {
  font-size: 11px;
}

/* Header bar with tabs (gtk-titlebar-style = tabs): libadwaita sizes it for
   touch (46px, 34px buttons). Trim it to ~29px, about a Breeze title bar.
   In this mode Ghostty's buttons live in the tab bar's start/end actions, not
   directly in headerbar, hence the tabbar selectors. Custom CSS is loaded at
   user priority, so these plain selectors beat libadwaita's more specific
   ones. */

headerbar {
  min-height: 0;
}

headerbar > windowhandle > box {
  padding: 1px 4px;
}

headerbar button,
tabbar button,
windowcontrols > button {
  min-height: 20px;
  min-width: 20px;
  padding: 1px;
}

windowcontrols > button > image {
  padding: 3px;
}

tabbar .start-action,
tabbar .end-action {
  padding-top: 3px;
  padding-bottom: 3px;
}

tabbar tab button.image-button {
  min-height: 16px;
  min-width: 16px;
}

windowcontrols > .icon {
  margin: 3px;
}
