+/* Adapter names in Wine are Linux interface names. Wine exposes neither the bus
+ * of an adapter nor its burned-in address, so read them from sysfs. */
+static BOOL read_sysfs_net( const WCHAR *ifname, const WCHAR *file, char *buf, DWORD size )
+{
+    WCHAR path[MAX_PATH];
+    HANDLE handle;
+    DWORD count = 0;
+    BOOL ret;
+
+    swprintf( path, ARRAY_SIZE(path), L"\\\\?\\unix\\sys\\class\\net\\%s\\%s", ifname, file );
+    handle = CreateFileW( path, GENERIC_READ, FILE_SHARE_READ, NULL, OPEN_EXISTING, 0, NULL );
+    if (handle == INVALID_HANDLE_VALUE) return FALSE;
+    ret = ReadFile( handle, buf, size - 1, &count, NULL );
+    CloseHandle( handle );
+    buf[count] = 0;
+    return ret && count;
+}
+
+static const char *get_uevent_value( const char *event, const char *key )
+{
+    size_t len = strlen( key );
+    const char *line = event;
+
+    while (line)
+    {
+        if (!strncmp( line, key, len ) && line[len] == '=') return line + len + 1;
+        if ((line = strchr( line, '\n' ))) line++;
+    }
+    return NULL;
+}
+
+static WCHAR *get_netadapter_pnpdevice_id( const WCHAR *ifname, int *is_virtual, int *wdm_interface )
+{
+    char event[4096];
+    const char *value;
+    UINT vendor, device, sub_vendor = 0, sub_device = 0;
+    WCHAR *ret;
+
+    if (!(ret = malloc( 96 * sizeof(WCHAR) ))) return NULL;
+    *is_virtual = 0;
+    *wdm_interface = 0;
+
+    if (!read_sysfs_net( ifname, L"device\\uevent", event, sizeof(event) ))
+    {
+        *is_virtual = -1;
+        swprintf( ret, 96, L"ROOT\\NET\\%s", ifname );
+    }
+    else if ((value = get_uevent_value( event, "PCI_ID" )) && sscanf( value, "%x:%x", &vendor, &device ) == 2)
+    {
+        if ((value = get_uevent_value( event, "PCI_SUBSYS_ID" ))) sscanf( value, "%x:%x", &sub_vendor, &sub_device );
+        swprintf( ret, 96, L"PCI\\VEN_%04X&DEV_%04X&SUBSYS_%04X%04X\\%s", vendor, device, sub_device, sub_vendor, ifname );
+    }
+    else if ((value = get_uevent_value( event, "PRODUCT" )) && sscanf( value, "%x/%x", &vendor, &device ) == 2)
+    {
+        *wdm_interface = -1;
+        swprintf( ret, 96, L"USB\\VID_%04X&PID_%04X\\%s", vendor, device, ifname );
+    }
+    else if ((value = get_uevent_value( event, "SDIO_ID" )) && sscanf( value, "%x:%x", &vendor, &device ) == 2)
+    {
+        swprintf( ret, 96, L"SD\\VID_%04X&PID_%04X\\%s", vendor, device, ifname );
+    }
+    else swprintf( ret, 96, L"PLATFORM\\%s", ifname );
+    return ret;
+}
+
+static WCHAR *get_permanent_address( const WCHAR *ifname, const BYTE *addr, DWORD len )
+{
+    char text[32];
+    UINT perm[6];
+    WCHAR *ret;
+    int i;
+
+    /* NetworkManager and similar tools can replace the current address of a
+     * Wi-Fi adapter. The phy keeps the burned-in one. */
+    if (!read_sysfs_net( ifname, L"phy80211\\macaddress", text, sizeof(text) ) ||
+        sscanf( text, "%x:%x:%x:%x:%x:%x", &perm[0], &perm[1], &perm[2], &perm[3], &perm[4], &perm[5] ) != 6)
+    {
+        if (len != 6) return NULL;
+        for (i = 0; i < 6; i++) perm[i] = addr[i];
+    }
+    if (!(perm[0] | perm[1] | perm[2] | perm[3] | perm[4] | perm[5])) return NULL;
+    if (!(ret = malloc( 13 * sizeof(WCHAR) ))) return NULL;
+    swprintf( ret, 13, L"%02X%02X%02X%02X%02X%02X", perm[0], perm[1], perm[2], perm[3], perm[4], perm[5] );
+    return ret;
+}
+
+static UINT32 get_ndis_physical_medium( DWORD type )
+{
+    switch (type)
+    {
+    case IF_TYPE_IEEE80211:       return 9;  /* NdisPhysicalMediumNative802_11 */
+    case IF_TYPE_ETHERNET_CSMACD: return 14; /* NdisPhysicalMedium802_3 */
+    default:                      return 0;  /* NdisPhysicalMediumUnspecified */
+    }
+}
+
+static enum fill_status fill_msft_netadapter( struct table *table, const struct expr *cond )
+{
+    struct record_msft_netadapter *rec;
+    IP_ADAPTER_ADDRESSES *aa, *buffer;
+    UINT row = 0, offset = 0, count = 0;
+    enum fill_status status = FILL_STATUS_UNFILTERED;
+
+    if (!(buffer = get_network_adapters())) return FILL_STATUS_FAILED;
+
+    for (aa = buffer; aa; aa = aa->Next)
+    {
+        if (aa->IfType != IF_TYPE_SOFTWARE_LOOPBACK) count++;
+    }
+    if (!resize_table( table, count, sizeof(*rec) ))
+    {
+        free( buffer );
+        return FILL_STATUS_FAILED;
+    }
+    for (aa = buffer; aa; aa = aa->Next)
+    {
+        if (aa->IfType == IF_TYPE_SOFTWARE_LOOPBACK) continue;
+
+        rec = (struct record_msft_netadapter *)(table->data + offset);
+        rec->device_id            = get_networkadapter_guid( &aa->Luid );
+        rec->interface_type       = aa->IfType;
+        rec->ndis_physical_medium = get_ndis_physical_medium( aa->IfType );
+        rec->permanent_address    = get_permanent_address( aa->FriendlyName, aa->PhysicalAddress, aa->PhysicalAddressLength );
+        rec->pnpdevice_id         = get_netadapter_pnpdevice_id( aa->FriendlyName, &rec->is_virtual, &rec->wdm_interface );
+        if (!match_row( table, row, cond, &status ))
+        {
+            free_row_values( table, row );
+            continue;
+        }
+        offset += sizeof(*rec);
+        row++;
+    }
+    TRACE("created %u rows\n", row);
+    table->num_rows = row;
+
+    free( buffer );
+    return status;
+}
+
