// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "cli_default_open_behavior": "existing_window",
  "project_panel": {
    "dock": "left"
  },
  "outline_panel": {
    "dock": "left"
  },
  "collaboration_panel": {
    "dock": "left"
  },
  "git_panel": {
    "dock": "left"
  },
  "agent": {
    "dock": "right",
    "play_sound_when_agent_done": "never",
    "model_parameters": []
  },
  "minimum_contrast_for_highlights": 61.0,
  "telemetry": {
    "diagnostics": false,
    "metrics": false
  },
  "languages": {
    "Ruby": {
      "language_servers": ["ruby-lsp", "!solargraph", "!rubocop", "..."],
      "semantic_tokens": "combined",
      "document_symbols": "on",
      "document_folding_ranges": "on",
      "inlay_hints": {
        "enabled": true
      }
    },
    "HTML+ERB": {
      "language_servers": ["herb", "ruby-lsp", "..."],
      "inlay_hints": {
        "enabled": true
      }
    },
    "JS+ERB": {
      "language_servers": ["ruby-lsp", "..."]
    },
    "YAML+ERB": {
      "language_servers": ["ruby-lsp", "..."]
    }
  },
  "vim_mode": true,
  "icon_theme": "Zed (Default)",
  "ui_font_size": 16,
  "buffer_font_size": 15,
  "theme": "One Dark",
  "theme_overrides": {
    "One Dark": {
      "background": "#0A0A0A",
      "surface.background": "#111111",
      "elevated_surface.background": "#191919",
      "panel.background": "#0A0A0A",
      "title_bar.background": "#0A0A0A",
      "title_bar.inactive_background": "#0A0A0A",
      "status_bar.background": "#0A0A0A",
      "tab_bar.background": "#0A0A0A",
      "tab.inactive_background": "#0A0A0A",
      "tab.active_background": "#111111",
      "toolbar.background": "#111111",
      "editor.background": "#111111",
      "editor.gutter.background": "#111111",
      "editor.subheader.background": "#161616",
      "editor.active_line.background": "#1B1B1B",
      "editor.highlighted_line.background": "#202020",
      "terminal.background": "#111111",
      "border": "#292929",
      "border.variant": "#202020"
    }
  }
}
