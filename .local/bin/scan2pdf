#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.11"
# dependencies = [
#     "ocrmypdf>=17,<18",
#     "img2pdf",
#     "rzr",
# ]
# [tool.uv.sources]
# rzr = { path = "../lib/rzr", editable = true }
# ///
"""Scan or take a PDF, resample to 1-bit, deskew, OCR (eng+pol)."""

import datetime
import json
import os
import re
import shutil
import subprocess
import sys
import tempfile
from pathlib import Path

from rzr import cli, die, info, main, ok, progress, run, status

BACKUP_DIR = "_scan2pdf_originals"
CONFIG = Path(os.environ.get("XDG_CONFIG_HOME", Path.home() / ".config")) / "scan2pdf"
DEVICE_CACHE = CONFIG / "device.json"
TOOLS = ["pdftoppm", "magick", "tesseract", "gs"]

HELP = """\
Examples:
  scan2pdf invoice.pdf             process in place; original goes to _scan2pdf_originals/
  scan2pdf *.pdf                   batch
  scan2pdf                         scan to scan-YYYY-MM-DD-HHMMSS.pdf in the current directory
  scan2pdf -o contract.pdf         scan to a named file
  scan2pdf --no-threshold photo.pdf
  scan2pdf --restore invoice.pdf   put the original back
  scan2pdf doc.pdf -- --rotate-pages

Arguments after -- go to ocrmypdf. System tools: scanimage (sane-backends +
sane-airscan), pdftoppm (poppler), magick (ImageMagick 7), tesseract with eng
and pol data, ghostscript, jbig2enc.
"""


def kb(path):
    return f"[num]{path.stat().st_size // 1024} KB[/]"


def shown(path):
    try:
        return path.relative_to(Path.cwd())
    except ValueError:
        return path


def check_tools(names):
    missing = [n for n in names if shutil.which(n) is None]
    if missing:
        die("missing tools: " + ", ".join(f"[cmd]{m}[/]" for m in missing))


# --- scanning ---------------------------------------------------------------

def discover_device():
    listing = subprocess.run(["scanimage", "-L"], capture_output=True, text=True, check=True).stdout
    devices = re.findall(r"device `([^']+)'", listing)
    preferred = [d for d in devices if d.startswith(("escl:", "airscan:"))]
    if not preferred:
        seen = f"; saw: {', '.join(devices)}" if devices else ""
        die(f"no eSCL/AirScan scanner found by [cmd]scanimage -L[/]{seen}")
    return preferred[0]


def device_for(args):
    if args.device:
        return args.device
    try:
        return json.loads(DEVICE_CACHE.read_text())["device"]
    except (OSError, KeyError, ValueError):
        if args.dry_run:
            return "escl:<device>"
    with status("looking for a scanner"):
        device = discover_device()
    CONFIG.mkdir(parents=True, exist_ok=True)
    DEVICE_CACHE.write_text(json.dumps({"device": device}) + "\n")
    info(f"using [accent]{device}[/] [muted](cached in {DEVICE_CACHE})[/]")
    return device


def scan(dest, args):
    device = device_for(args)
    mode = "Color" if args.color else "Gray"
    with status("scanning"):
        run(["scanimage", "-d", device, "--mode", mode, "--resolution", args.dpi,
             "--format", "pdf", "-o", dest], dry_run=args.dry_run)


# --- processing -------------------------------------------------------------

def rasterize(src, work, args):
    run(["pdftoppm", "-r", args.dpi, "-gray", "-png", src, work / "page"], dry_run=args.dry_run)
    pages = sorted(work.glob("page-*.png"))
    if not pages and not args.dry_run:
        die(f"[cmd]pdftoppm[/] produced no pages from [path]{src}[/]")
    return pages


def threshold(page, args):
    bw = page.with_name(page.stem + "-bw.png")
    run(["magick", page, "-auto-threshold", "OTSU", "-type", "bilevel", bw], dry_run=args.dry_run)
    return bw


def ocr(src, dest, args):
    cmd = [sys.executable, "-m", "ocrmypdf", "--quiet", "-l", args.lang, "--deskew", "--optimize", "3", "--skip-text"]
    if args.no_threshold:
        cmd.append("--clean")
    run(cmd + args.ocrmypdf_args + [src, dest], dry_run=args.dry_run)


def process(src, dest, label, args):
    with tempfile.TemporaryDirectory(prefix="scan2pdf-") as tmp, progress(disable=args.dry_run) as bar:
        work = Path(tmp)
        task = bar.add_task(f"[path]{label}[/] [muted]rasterizing[/]", total=None)
        ocr_input = src
        if not args.no_threshold:
            pages = rasterize(src, work, args)
            bar.update(task, total=2 * len(pages) + 1, description=f"[path]{label}[/] [muted]thresholding[/]")
            bw = []
            for page in pages:
                bw.append(threshold(page, args))
                bar.advance(task)
            ocr_input = work / "bw.pdf"
            run([sys.executable, "-m", "img2pdf", "-o", ocr_input, *bw], dry_run=args.dry_run)
            bar.advance(task)
        else:
            bar.update(task, total=2)
        bar.update(task, description=f"[path]{label}[/] [muted]OCR[/]")
        ocr(ocr_input, dest, args)
        bar.update(task, completed=bar.tasks[task].total)


def backup_of(pdf):
    return pdf.parent / BACKUP_DIR / pdf.name


def process_in_place(pdf, args):
    pdf = pdf.resolve()
    if not pdf.is_file():
        die(f"[path]{shown(pdf)}[/]: no such file (positional arguments are existing PDFs; use [cmd]-o[/] to scan)")
    backup = backup_of(pdf)
    if backup.exists():
        die(f"[path]{pdf.name}[/]: already processed, original is at [path]{shown(backup)}[/] (use [cmd]--restore[/] to undo)")
    fresh = pdf.with_name(f".{pdf.name}.scan2pdf.tmp")
    process(pdf, fresh, pdf.name, args)
    if args.dry_run:
        return
    backup.parent.mkdir(exist_ok=True)
    shutil.copy2(pdf, backup)
    os.replace(fresh, pdf)
    ok(f"[path]{pdf.name}[/] {kb(backup)} [muted]→[/] {kb(pdf)}")


def restore(pdf):
    pdf = pdf.resolve()
    backup = backup_of(pdf)
    if not backup.is_file():
        die(f"no backup at [path]{shown(backup)}[/]")
    os.replace(backup, pdf)
    try:
        backup.parent.rmdir()
    except OSError:
        pass
    ok(f"restored [path]{pdf.name}[/] {kb(pdf)}")


def scan_and_process(args):
    dest = args.output or Path(datetime.datetime.now().strftime("scan-%Y-%m-%d-%H%M%S.pdf"))
    if dest.exists():
        die(f"[path]{dest}[/] already exists")
    with tempfile.TemporaryDirectory(prefix="scan2pdf-") as tmp:
        raw = Path(tmp) / "raw.pdf"
        scan(raw, args)
        process(raw, dest, dest.name, args)
    if not args.dry_run:
        ok(f"[path]{dest}[/] {kb(dest)}")


# --- cli --------------------------------------------------------------------

def parse_args():
    parser = cli("scan2pdf", __doc__, HELP)
    parser.add_argument("files", nargs="*", type=Path, metavar="FILE", help="existing PDFs to process in place")
    parser.add_argument("-o", "--output", type=Path, metavar="OUT.pdf", help="scan to this file (scan mode)")
    parser.add_argument("--restore", action="store_true", help="restore FILE(s) from backup")
    parser.add_argument("-l", "--lang", default="eng+pol", help="tesseract languages (default: %(default)s)")
    parser.add_argument("-r", "--dpi", type=int, default=300, help="scan/raster resolution (default: %(default)s)")
    parser.add_argument("--no-threshold", action="store_true", help="skip 1-bit resampling (grayscale documents)")
    parser.add_argument("--color", action="store_true", help="scan in color (implies --no-threshold)")
    parser.add_argument("--device", help="SANE device (default: first escl:/airscan: device, cached)")
    parser.add_argument("-n", "--dry-run", action="store_true", help="print commands without running them")

    argv = sys.argv[1:]
    passthrough = []
    if "--" in argv:
        split = argv.index("--")
        argv, passthrough = argv[:split], argv[split + 1:]
    args = parser.parse_args(argv)
    args.ocrmypdf_args = passthrough
    args.no_threshold = args.no_threshold or args.color

    if args.restore and (args.output or not args.files):
        parser.error("--restore takes FILE arguments only")
    if args.files and args.output:
        parser.error("-o is for scan mode; it cannot be combined with input files")
    return args


@main
def scan2pdf():
    args = parse_args()
    if args.restore:
        for pdf in args.files:
            restore(pdf)
    elif args.files:
        if not args.dry_run:
            check_tools(TOOLS)
        for pdf in args.files:
            process_in_place(pdf, args)
    else:
        if not args.dry_run:
            check_tools(["scanimage", *TOOLS])
        scan_and_process(args)


if __name__ == "__main__":
    scan2pdf()
