#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.11"
# dependencies = [
#     "guessit>=3.8",
#     "py7zr>=1",
#     "pysubs2>=1.7",
#     "rzr",
# ]
# [tool.uv.sources]
# rzr = { path = "../lib/rzr", editable = true }
# ///
"""Prepare movies for Plex: NapiProjekt subtitles, a stereo track, Plex names."""

import base64
import hashlib
import json
import os
import re
import shutil
import subprocess
import tempfile
import urllib.parse
import urllib.request
from fractions import Fraction
from pathlib import Path

import guessit
import py7zr
import pysubs2
from rich.markup import escape
from rzr import cli, die, fail, info, main, ok, progress, status, warn

API = "https://napiprojekt.pl/api/api-napiprojekt3.php"
# Shared by every NapiProjekt client; the API only answers known client IDs.
CLIENT = {"client": "NapiProjektPython", "client_ver": "2.2.0.2399"}
ARCHIVE_PASSWORD = "iBlm8NTigvru0Jr0"
LANGUAGES = {"pl": "PL", "en": "ENG"}
HASHED_BYTES = 10 * 1024 * 1024
CHUNK = 256 * 1024

POLISH = set("ąćęłńóśźżĄĆĘŁŃÓŚŹŻ")
# LG TVs since the 2020 models cannot decode DTS, so Plex transcodes it.
UNPLAYABLE = {"dts"}
# Left surround channels per layout. Center (dialogue) dominates the downmix;
# `<` renormalizes the gains so the sum cannot clip.
SURROUNDS = {"5.1": ["BL"], "5.1(side)": ["SL"], "6.1": ["SL", "BC"], "7.1": ["SL", "BL"]}
TOOLS = ["ffmpeg", "ffprobe"]

HELP = """\
Examples:
  subs Movie.2019.1080p.mkv          save Movie.2019.1080p.pl.srt beside it
  subs *.mkv                         batch
  subs --rename Show.S01E02.mkv      rename to "Show - S01E02.mkv" first
  subs --stereo Movie.mkv            add a stereo AAC track if it has none
  subs --lang en --force Movie.mkv   English, replacing an existing file

Subtitles come from NapiProjekt, matched by a hash of the first 10 MB, and are
saved as UTF-8 SRT sidecars, which Plex picks up and labels by language.
--stereo adds a dialogue-forward stereo downmix when the file has no stereo
track or only DTS audio, keeping every other stream as is.
"""


# --- subtitles --------------------------------------------------------------


def movie_hash(path, on_read=lambda n: None):
    digest = hashlib.md5()
    with open(path, "rb") as f:
        while left := HASHED_BYTES - f.tell():
            chunk = f.read(min(CHUNK, left))
            if not chunk:
                break
            digest.update(chunk)
            on_read(len(chunk))
    return digest.hexdigest()


def hash_with_progress(path):
    with progress(bytes=True) as bar:
        task = bar.add_task("Hashing start of file", total=min(HASHED_BYTES, path.stat().st_size))
        return movie_hash(path, lambda n: bar.advance(task, n))


def fetch(digest, lang):
    form = {
        "mode": 17,
        **CLIENT,
        "downloaded_subtitles_id": digest,
        "downloaded_subtitles_lang": lang,
    }
    request = urllib.request.Request(API, urllib.parse.urlencode(form).encode())
    with urllib.request.urlopen(request, timeout=30) as response:
        return unpack(response.read().decode("utf-8", "replace"))


def unpack(xml):
    if "<status>success</status>" not in xml:
        return None
    content = re.search(r"<content>\s*<!\[CDATA\[(.*?)\]\]>\s*</content>", xml, re.S)
    if not content:
        return None
    with tempfile.TemporaryDirectory() as tmp:
        archive, out = Path(tmp) / "subs.7z", Path(tmp) / "out"
        archive.write_bytes(base64.b64decode(content.group(1)))
        try:
            with py7zr.SevenZipFile(archive, password=ARCHIVE_PASSWORD) as z:
                z.extractall(out)
        except py7zr.exceptions.ArchiveError as error:
            raise RuntimeError(f"unreadable NapiProjekt archive: {error}") from error
        files = sorted(p for p in out.rglob("*") if p.is_file())
        return files[0].read_bytes() if files else None


def decode(raw):
    raw = raw.removeprefix(b"\xef\xbb\xbf")
    try:
        return raw.decode("utf-8")
    except UnicodeDecodeError:
        pass
    # Polish subtitles are CP1250 or ISO-8859-2; they differ in ą, ś, ź and
    # their capitals, so the one producing more Polish letters is right.
    candidates = [raw.decode(enc, "replace") for enc in ("cp1250", "iso-8859-2")]
    return max(candidates, key=lambda text: sum(ch in POLISH for ch in text))


def to_srt(text, fps):
    return pysubs2.SSAFile.from_string(text, fps=fps).to_string("srt")


def sidecar(video, suffix):
    return video.with_name(f"{video.stem}.{suffix}.srt")


# --- media ------------------------------------------------------------------


def probe(path):
    out = subprocess.run(
        [
            "ffprobe",
            "-v",
            "error",
            "-show_entries",
            "stream=index,codec_type,codec_name,channels,channel_layout,r_frame_rate,disposition:format=duration",
            "-of",
            "json",
            str(path),
        ],
        capture_output=True,
        text=True,
        check=True,
    ).stdout
    return json.loads(out)


def fps(media):
    for stream in media["streams"]:
        if stream["codec_type"] == "video" and stream.get("r_frame_rate", "0/0") != "0/0":
            return float(Fraction(stream["r_frame_rate"]))
    return 23.976


def audio(media):
    return [s for s in media["streams"] if s["codec_type"] == "audio"]


def needs_stereo(tracks):
    return bool(tracks) and not any(
        t.get("channels") == 2 and t["codec_name"] not in UNPLAYABLE for t in tracks
    )


def source_track(tracks):
    for n, track in enumerate(tracks):
        if track.get("disposition", {}).get("default"):
            return n
    return 0


def downmix(track):
    surrounds = SURROUNDS.get(track.get("channel_layout", ""))
    if not surrounds:
        return ["-ac:a:0", "2"]

    def side(fl, *rest):
        return "+".join(["FC", f"0.3*{fl}", *(f"0.3*{s}" for s in rest)])

    left = side("FL", *surrounds)
    right = side("FR", *(s[:-1] + "R" if s.endswith("L") else s for s in surrounds))
    return ["-filter:a:0", f"pan=stereo|FL<{left}|FR<{right}"]


def stereo_command(src, dest, n, track):
    return [
        "ffmpeg",
        "-nostdin",
        "-v",
        "error",
        "-y",
        "-i",
        src,
        "-map",
        "0:v?",
        "-map",
        f"0:a:{n}",
        "-map",
        "0:a",
        "-map",
        "0:s?",
        "-map",
        "0:t?",
        "-map_metadata",
        "0",
        "-c",
        "copy",
        "-c:a:0",
        "aac",
        "-b:a:0",
        "192k",
        *downmix(track),
        "-metadata:s:a:0",
        "title=Stereo",
        "-disposition:a",
        "0",
        "-disposition:a:0",
        "default",
        *(["-movflags", "+faststart"] if dest.suffix.lower() in (".mp4", ".m4v", ".mov") else []),
        "-progress",
        "pipe:1",
        "-nostats",
        dest,
    ]


def add_stereo(video, media):
    tracks = audio(media)
    if not needs_stereo(tracks):
        return False
    n = source_track(tracks)
    duration = float(media.get("format", {}).get("duration", 0))
    size = video.stat().st_size
    with tempfile.TemporaryDirectory(prefix=".subs-", dir=video.parent) as tmp:
        fresh = Path(tmp) / video.name
        cmd = [str(c) for c in stereo_command(video, fresh, n, tracks[n])]
        # ffmpeg reports progress as playback time; scaling it to the file size
        # shows how much of a large NAS file has been read, and how fast.
        with progress(bytes=True) as bar:
            task = bar.add_task("Adding stereo track", total=size if duration else None)
            with subprocess.Popen(
                cmd, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True
            ) as ffmpeg:
                for line in ffmpeg.stdout:
                    if duration and line.startswith("out_time_us=") and line[12:].strip().isdigit():
                        done = min(int(line[12:]) / 1_000_000 / duration, 1)
                        bar.update(task, completed=done * size)
                errors = ffmpeg.stderr.read()
        if ffmpeg.returncode:
            raise RuntimeError(errors.strip() or f"ffmpeg exited with {ffmpeg.returncode}")
        shutil.copymode(video, fresh)
        os.replace(fresh, video)
    return True


# --- naming -----------------------------------------------------------------


def plex_name(filename):
    guess = guessit.guessit(filename)
    title = str(guess.get("title", "")).replace("/", "-").strip()
    if not title:
        return None
    suffix = Path(filename).suffix
    if (
        guess.get("type") == "episode"
        and isinstance(guess.get("season"), int)
        and isinstance(guess.get("episode"), int)
    ):
        return f"{title} - S{guess['season']:02}E{guess['episode']:02}{suffix}"
    year = guess.get("year")
    return f"{title} ({year}){suffix}" if year else f"{title}{suffix}"


def rename(video):
    name = plex_name(video.name)
    if not name or name == video.name:
        return video
    dest = video.with_name(name)
    if dest.exists():
        raise FileExistsError(f"{dest.name} already exists")
    video.rename(dest)
    for old in video.parent.glob(f"{glob_escape(video.stem)}.*.srt"):
        old.rename(dest.with_name(dest.stem + old.name[len(video.stem) :]))
    ok(f"Renamed to [path]{escape(name)}[/]")
    return dest


def glob_escape(text):
    return re.sub(r"([\[\]*?])", r"[\1]", text)


# --- run ----------------------------------------------------------------------


def prepare(video, args):
    if args.rename:
        video = rename(video)
    with status("Reading media info"):
        media = probe(video)

    srt = sidecar(video, args.lang)
    if srt.exists() and not args.force:
        info(f"[path]{escape(srt.name)}[/] exists [muted](--force to replace)[/]")
    else:
        digest = hash_with_progress(video)
        with status("Asking NapiProjekt"):
            raw = fetch(digest, LANGUAGES[args.lang])
        if raw is None:
            warn(f"No subtitles on NapiProjekt for [path]{escape(video.name)}[/]")
        else:
            srt.write_text(to_srt(decode(raw), fps(media)), encoding="utf-8")
            ok(f"Saved [path]{escape(srt.name)}[/]")

    if args.stereo:
        if add_stereo(video, media):
            ok("Added a stereo track")
        else:
            info("Stereo track present")


@main
def subs():
    parser = cli("subs", "Prepare movies for Plex: NapiProjekt subtitles, stereo, names.", HELP)
    parser.add_argument("videos", nargs="+", type=Path, metavar="video")
    parser.add_argument(
        "--lang", choices=LANGUAGES, default="pl", help="subtitle language (default: pl)"
    )
    parser.add_argument("--stereo", action="store_true", help="add a stereo AAC track if missing")
    parser.add_argument(
        "--rename", action="store_true", help="rename to Plex's naming scheme first"
    )
    parser.add_argument("--force", action="store_true", help="replace existing subtitles")
    args = parser.parse_args()

    missing = [t for t in TOOLS if shutil.which(t) is None]
    if missing:
        die("missing tools: " + ", ".join(f"[cmd]{m}[/]" for m in missing))

    failed = 0
    total = len(args.videos)
    for n, video in enumerate(args.videos, 1):
        if total > 1:
            info(f"[title]{escape(video.name)}[/] [muted]({n}/{total})[/]")
        try:
            if not video.is_file():
                raise FileNotFoundError(f"{video} is not a file")
            prepare(video, args)
        except (OSError, RuntimeError, ValueError, subprocess.CalledProcessError) as error:
            fail(escape(str(error)))
            failed += 1
    if failed:
        raise SystemExit(1)


if __name__ == "__main__":
    subs()
