#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.11,<3.14"
# dependencies = [
#     "kokoro-onnx",
#     "trafilatura",
#     "markdown-it-py",
#     "soundfile",
#     "numpy",
#     "rzr",
# ]
# [tool.uv.sources]
# rzr = { path = "../lib/rzr", editable = true }
# ///
"""Read an article aloud with local TTS (Kokoro)."""

import re
import shutil
import subprocess
import sys
import threading
import urllib.request
from dataclasses import dataclass
from pathlib import Path
from queue import Queue

import numpy as np
import soundfile
from markdown_it import MarkdownIt
from rzr import cli, die, info, main, ok, out, progress, status, warn

CACHE = Path.home() / ".cache" / "narrate"
LAST = CACHE / "last.wav"
MODEL_URL = "https://github.com/thewh1teagle/kokoro-onnx/releases/download/model-files-v1.1"
MODEL_FILES = ("kokoro-v1.0.onnx", "voices-v1.0.bin")
RATE = 24000

PAUSE_BEFORE_HEADER = 1.2
PAUSE_AFTER_HEADER = 0.8
PAUSE_AFTER_PARAGRAPH = 0.6
PAUSE_AFTER_LIST_ITEM = 0.3
PAUSE_AFTER_LIST = 0.4
PAUSE_AROUND_QUOTE = 0.5
PAUSE_AFTER_SKIPPED = 0.4
PAUSE_SECTION_BREAK = 1.0

# Headers and quotes are read in a blend of the main voice and a second voice
# of the same gender and accent, so the narrator keeps their identity but
# audibly shifts tone. Keyed by voice name prefix (af = American female, ...).
BLEND_PARTNER = {"af": "af_nicole", "am": "am_michael", "bf": "bf_emma", "bm": "bm_george"}

HELP = """\
Examples:
  narrate https://example.com/article
  narrate notes.md
  cat notes.md | narrate -
  narrate --voice bm_george --speed 1.2 notes.md
  narrate --save talk.wav notes.md

Headings and quotes are read in a slightly different voice. Tables and code
blocks are skipped. The last narration is kept at ~/.cache/narrate/last.wav.
"""


@dataclass
class Speak:
    text: str
    style: str  # body, header or quote


@dataclass
class Pause:
    seconds: float


def load_markdown(source):
    if source == "-":
        return sys.stdin.read()
    if source.startswith(("http://", "https://")):
        return fetch_article(source)
    path = Path(source)
    if path.exists():
        return path.read_text()
    if looks_like_url(source):
        return fetch_article(f"https://{source}")
    die(f"no such file: [path]{source}[/]")


def looks_like_url(text):
    if Path(text).suffix in (".md", ".markdown", ".txt"):
        return False
    return re.match(r"[\w.-]+\.[a-z]{2,}(/|$)", text)


def fetch_article(url):
    import trafilatura  # slow import, only needed for URLs

    with status(f"fetching [path]{url}[/]"):
        html = trafilatura.fetch_url(url)
    if not html:
        die(f"could not fetch [path]{url}[/]")
    markdown = trafilatura.extract(
        html, output_format="markdown", include_links=False, include_images=False
    )
    if not markdown:
        die("no article content found on that page")

    meta = trafilatura.extract_metadata(html)
    if meta and meta.title and not markdown.lstrip().startswith("#"):
        markdown = f"# {meta.title}\n\n{markdown}"
    return markdown


def title_of(markdown):
    match = re.search(r"^#\s+(.+)$", markdown, re.MULTILINE)
    return match.group(1).strip() if match else None


def to_events(markdown):
    tokens = MarkdownIt().enable("table").parse(markdown)
    events = []
    style = "body"
    list_depth = 0
    in_table = False

    for token in tokens:
        match token.type:
            case "table_open":
                in_table = True
                events += [Speak("Table skipped.", "body"), Pause(PAUSE_AFTER_SKIPPED)]
            case "table_close":
                in_table = False
            case _ if in_table:
                pass
            case "heading_open":
                events.append(Pause(PAUSE_BEFORE_HEADER))
                style = "header"
            case "heading_close":
                events.append(Pause(PAUSE_AFTER_HEADER))
                style = "body"
            case "blockquote_open":
                events.append(Pause(PAUSE_AROUND_QUOTE))
                style = "quote"
            case "blockquote_close":
                events.append(Pause(PAUSE_AROUND_QUOTE))
                style = "body"
            case "bullet_list_open" | "ordered_list_open":
                list_depth += 1
            case "bullet_list_close" | "ordered_list_close":
                list_depth -= 1
                if list_depth == 0:
                    events.append(Pause(PAUSE_AFTER_LIST))
            case "fence" | "code_block":
                events += [Speak("Code sample skipped.", "body"), Pause(PAUSE_AFTER_SKIPPED)]
            case "hr":
                events.append(Pause(PAUSE_SECTION_BREAK))
            case "inline":
                events += [Speak(chunk, style) for chunk in chunks(inline_text(token))]
            case "paragraph_close":
                events.append(Pause(PAUSE_AFTER_LIST_ITEM if list_depth else PAUSE_AFTER_PARAGRAPH))

    return events


def inline_text(token):
    parts = []
    for child in token.children or []:
        if child.type in ("text", "code_inline"):
            parts.append(child.content)
        elif child.type in ("softbreak", "hardbreak"):
            parts.append(" ")
    return "".join(parts).strip()


def chunks(text, limit=300):
    """Split text into sentence batches short enough for one TTS call."""
    sentences = re.split(r"(?<=[.!?…])\s+", text)
    batches = []
    current = ""
    for sentence in sentences:
        if current and len(current) + len(sentence) > limit:
            batches.append(current)
            current = sentence
        else:
            current = f"{current} {sentence}".strip()
    if current:
        batches.append(current)
    return batches


def download(url, dest, name):
    with progress(bytes=True) as bar, urllib.request.urlopen(url) as response:
        task = bar.add_task(name, total=int(response.headers.get("Content-Length", 0)) or None)
        with open(dest, "wb") as file:
            while block := response.read(1 << 16):
                file.write(block)
                bar.advance(task, len(block))


def ensure_model_files():
    CACHE.mkdir(parents=True, exist_ok=True)
    paths = []
    for name in MODEL_FILES:
        path = CACHE / name
        if not path.exists():
            info(f"downloading [path]{name}[/] (one time)")
            partial = path.with_name(name + ".part")
            download(f"{MODEL_URL}/{name}", partial, name)
            partial.rename(path)
        paths.append(path)
    return paths


def load_kokoro():
    model, voices = ensure_model_files()
    with status("loading voice model"):
        from kokoro_onnx import Kokoro  # slow import

        return Kokoro(str(model), str(voices))


def voice_styles(kokoro, voice):
    body = kokoro.get_voice_style(voice)
    partner = BLEND_PARTNER.get(voice[:2], voice)
    blend = body * 0.7 + kokoro.get_voice_style(partner) * 0.3
    return {"body": (body, 1.0), "header": (blend, 0.9), "quote": (blend, 1.0)}


def start_player():
    if shutil.which("mpv"):
        cmd = [
            "mpv",
            "--really-quiet",
            "--no-video",
            "--demuxer=rawaudio",
            "--demuxer-rawaudio-format=floatle",
            f"--demuxer-rawaudio-rate={RATE}",
            "--demuxer-rawaudio-channels=2",
            "-",
        ]
    elif shutil.which("ffplay"):
        cmd = [
            "ffplay",
            "-nodisp",
            "-autoexit",
            "-loglevel",
            "quiet",
            "-f",
            "f32le",
            "-ar",
            str(RATE),
            "-ac",
            "2",
            "-i",
            "-",
        ]
    else:
        die("no audio player found; install mpv")
    return subprocess.Popen(cmd, stdin=subprocess.PIPE)


def feed_player(player, pending):
    # Dual-mono: some players route a plain mono stream to the left channel only.
    try:
        while (samples := pending.get()) is not None:
            player.stdin.write(np.repeat(samples, 2).tobytes())
        player.stdin.close()
    except BrokenPipeError:
        pass  # player was closed mid-narration; stream() notices and stops


def stream(events, kokoro, voice, speed, player):
    """Synthesize events in order, playing each chunk as soon as it is ready."""
    styles = voice_styles(kokoro, voice)
    pending = Queue()
    feeder = threading.Thread(target=feed_player, args=(player, pending), daemon=True)
    feeder.start()

    pieces = []
    with progress() as bar:
        task = bar.add_task("narrating", total=sum(isinstance(e, Speak) for e in events))
        for event in events:
            if player.poll() is not None:
                break
            if isinstance(event, Pause):
                samples = np.zeros(int(event.seconds * RATE), dtype=np.float32)
            else:
                style_voice, style_speed = styles[event.style]
                samples, _ = kokoro.create(
                    event.text, voice=style_voice, speed=speed * style_speed, lang="en-us"
                )
                samples = samples.astype(np.float32, copy=False)
                bar.advance(task)
            pieces.append(samples)
            pending.put(samples)

    pending.put(None)
    feeder.join()
    player.wait()
    return np.concatenate(pieces) if pieces else np.zeros(0, dtype=np.float32)


def duration(samples):
    seconds = int(samples.size / RATE)
    return f"{seconds // 60}:{seconds % 60:02d}"


@main
def narrate():
    parser = cli("narrate", "Read an article aloud with local TTS (Kokoro).", HELP)
    parser.add_argument("source", nargs="?", help="article URL, markdown file, or - for stdin")
    parser.add_argument(
        "-v", "--voice", default="af_heart", help="Kokoro voice (default: %(default)s)"
    )
    parser.add_argument(
        "-s", "--speed", type=float, default=1.0, help="speech speed (default: %(default)s)"
    )
    parser.add_argument(
        "-o", "--save", type=Path, metavar="FILE", help="also write the narration to a WAV file"
    )
    parser.add_argument("--voices", action="store_true", help="list available voices and exit")
    args = parser.parse_args()

    if args.voices:
        out.print("\n".join(sorted(load_kokoro().get_voices())))
        return
    if not args.source:
        parser.error("source is required")

    markdown = load_markdown(args.source)
    events = to_events(markdown)
    if not any(isinstance(e, Speak) for e in events):
        die("nothing to narrate")

    kokoro = load_kokoro()
    if args.voice not in kokoro.get_voices():
        die(f"unknown voice [accent]{args.voice}[/]; run [cmd]narrate --voices[/] for the list")

    if title := title_of(markdown):
        out.print(f"[title]{title}[/]")
    info(f"[accent]{args.voice}[/] [muted]at[/] [num]{args.speed:g}x[/]")

    player = start_player()
    samples = stream(events, kokoro, args.voice, args.speed, player)
    if not samples.size:
        return

    stereo = np.column_stack([samples, samples])
    soundfile.write(LAST, stereo, RATE)
    if args.save:
        soundfile.write(args.save, stereo, RATE)
        ok(f"saved [path]{args.save}[/] [muted]({duration(samples)})[/]")
    elif player.returncode:
        warn(f"stopped after [num]{duration(samples)}[/]")
    else:
        ok(f"done [muted]({duration(samples)})[/]")


if __name__ == "__main__":
    narrate()
